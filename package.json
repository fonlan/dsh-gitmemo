{
  "name": "@fonlan/dsh-gitmemo",
  "version": "0.4.0",
  "description": "Git-backed long-term memory for DeepSeek Harness: a local .mem git repo (single main branch, immutable entries, structured commit messages) with mem_search / mem_read / mem_write / mem_delete / mem_replace tools and fully automatic legacy migration (no CLI needed; the CLI remains for explicit control), auto-managed by the root agent with zero manual steps.",
  "author": "fonlan",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fonlan/dsh-gitmemo.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "dsh-gitmemo": "lib/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./mem": {
      "types": "./lib/mem.d.ts",
      "default": "./lib/mem.js"
    },
    "./migrate": {
      "types": "./lib/migrate.d.ts",
      "default": "./lib/migrate.js"
    },
    "./cli": "./lib/cli.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x lib/cli.js && tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
    "bundle": "tsdown",
    "watch": "tsdown --watch",
    "test": "npm run build && node --test",
    "prepublishOnly": "npm run build",
    "release:patch": "npm version patch && git push && git push --tags",
    "release:minor": "npm version minor && git push && git push --tags",
    "release:major": "npm version major && git push && git push --tags"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-gateway": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-api-settings-controller": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-store": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.1.7-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^26.2.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.5.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "memory",
    "git",
    "long-term-memory"
  ],
  "license": "MIT"
}
